# PostgreSQL (password is required; user defaults to "postgres")
POSTGRES_PASSWORD=
# POSTGRES_USER=postgres

# Azure (required for cloud integration)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Flask session secret (required)
SECRET_KEY=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
