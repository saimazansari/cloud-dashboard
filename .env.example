# Azure Key Vault (recommended — zero secrets in files)
# Set this to fetch all secrets from Key Vault via Managed Identity.
# When set, POSTGRES_PASSWORD and SECRET_KEY below are ignored.
# AZURE_KEY_VAULT_URL=https://myvault.vault.azure.net/

# PostgreSQL (only needed if AZURE_KEY_VAULT_URL is not set)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Flask session secret (only needed if AZURE_KEY_VAULT_URL is not set)
SECRET_KEY=

# Azure (required for cloud integration)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
